    "کرده": { "fr": "fait (participe)" },
    "است": { "fr": "est", "note": "À l'oral : ـه collé au mot. درست کرده است → درست کرده." },
    "خانه‌ی": { "fr": "la maison de…", "note": "L'ezafé ـی relie خانه au mot suivant, comme « de »." },
    "یک": { "fr": "un, une", "note": "À l'oral : یه." },
    "کوچه‌ی": { "fr": "la ruelle de…" },
