  "chats": {
    "famil": {
      "title": "گروه فامیل",
      "fr_title": "Le groupe de la famille",
      "intro": "Un chat avec les cousins. Ici, on écrit comme on parle : c'est le registre familier, mais en alphabet persan. Touche un message pour la traduction.",
      "participants": { "sara": { "name": "سارا", "voice": "default", "color": "a" }, "amir": { "name": "امیر", "voice": "male", "color": "b" } },
      "script": [
        { "from": "sara", "text": "سلام! رسیدی؟ 😄", "fr": "Salut ! T'es arrivé(e) ?" },
        { "from": "amir", "text": "خوش اومدی به تهرون!", "fr": "Bienvenue à Téhéran !", "note": "اومدی = آمدی ; تهرون = تهران" },
        { "choice": [
          { "text": "سلام! آره، تازه رسیدم. چقدر گرمه!", "fr": "Salut ! Oui, je viens d'arriver. Qu'est-ce qu'il fait chaud !" },
          { "text": "مرسی! خیلی خوشحالم که اینجام.", "fr": "Merci ! Je suis trop content(e) d'être là." }
        ] },
        { "from": "sara", "text": "فردا شب مهمونی خونه‌ی خاله‌ست. میای؟", "fr": "Demain soir, il y a une mehmooni chez khale. Tu viens ?", "note": "مهمونی = مهمانی ; خونه = خانه ; ـست = است" },
        { "choice": [
          { "text": "آره حتماً! ساعت چند؟", "fr": "Oui, bien sûr ! À quelle heure ?" },
          { "text": "معلومه که میام. چی بیارم؟", "fr": "Évidemment que je viens. J'apporte quoi ?" }
        ] },
        { "from": "amir", "text": "ساعت ۸. خاله گفته برات غذای بدون گوشت درست می‌کنه 🌱", "fr": "À 8 h. Khale a dit qu'elle te prépare un plat sans viande.", "note": "برات = برایت ; می‌کنه = می‌کند" },
        { "choice": [
          { "text": "وای چه خوب! دست خاله درد نکنه.", "fr": "Oh, trop bien ! Merci à khale (litt. que sa main ne fasse pas mal)." },
          { "text": "چی درست می‌کنه؟", "fr": "Elle prépare quoi ?" }
        ] },
        { "from": "sara", "text": "کشک بادمجون و سالاد شیرازی. ولی کشک داره ها، کشک از شیره.", "fr": "Kashk-e bademjan et salade shirazi. Mais attention, il y a du kashk, et le kashk, c'est fait avec du lait.", "note": "بادمجون = بادمجان ; داره = دارد ; شیره = شیر است" },
        { "choice": [
          { "text": "من وگانم، کشک نمی‌خورم. ولی سالاد که هست!", "fr": "Je suis végane, je ne mange pas de kashk. Mais il y a la salade !" },
          { "text": "عیب نداره، من فقط گوشت نمی‌خورم. لبنیات اوکیه.", "fr": "Pas grave, moi je ne mange juste pas de viande. Les produits laitiers, ça va." }
        ] },
        { "from": "amir", "text": "باشه، به خاله می‌گم. فقط تعارف نکن ها، خاله عاشق اینه که مهمون زیاد بخوره 😂", "fr": "OK, je le dis à khale. Mais ne fais pas de taarof, khale adore quand l'invité mange beaucoup.", "note": "می‌گم = می‌گویم ; اینه = این است ; مهمون = مهمان ; بخوره = بخورد" },
        { "from": "sara", "text": "تا فردا! 👋", "fr": "À demain !" }
      ]
    }
  },

