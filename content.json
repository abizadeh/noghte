  "readings": {
    "day1": {
      "title": "روز اول",
      "fr_title": "Le premier jour",
      "intro": "Un texte en registre soutenu, comme dans un livre. Touche n'importe quel mot pour l'entendre et le comprendre.",
      "paragraphs": [
        [
          "هواپیما صبح زود در فرودگاه تهران نشست.",
          "دایی و پسردایی‌ام منتظر من بودند.",
          "هوا گرم بود و خیابان‌ها شلوغ.",
          "در راه خانه، دایی پرسید: «گرسنه‌ای؟»",
          "گفتم: «خیلی! اما من گیاه‌خوارم.»",
          "دایی خندید و گفت: «نگران نباش. مادربزرگ عدس‌پلو درست کرده است.»"
        ],
        [
          "خانه‌ی مادربزرگ در یک کوچه‌ی باریک است.",
          "بوی نان تازه از نانوایی سر کوچه می‌آمد.",
          "مادربزرگ در را باز کرد و گفت: «خوش آمدی، عزیزم. بیا تو.»"
        ]
      ],
      "questions": [
        { "q": "چه کسی عدس‌پلو درست کرده است؟", "options": ["مادربزرگ", "دایی", "پسردایی"], "answer": 0 },
        { "q": "هوا چطور بود؟", "options": ["گرم", "سرد", "بارانی"], "answer": 0 },
        { "q": "نانوایی کجاست؟", "options": ["سر کوچه", "در فرودگاه", "کنار مترو"], "answer": 0 }
      ]
    }
  },

