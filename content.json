    "بوی": { "fr": "l'odeur de…", "note": "بو + ezafé." },
    "نان": { "ref": "nan" },
    "تازه": { "fr": "frais, fraîche ; nouveau" },
    "از": { "fr": "de, depuis" },
    "نانوایی": { "fr": "boulangerie", "note": "نان (pain) + ـوایی. Souvent un sangak ou un barbari." },
    "سر": { "fr": "(ici) au bout de ; tête" },
    "کوچه": { "ref": "kuche" },
    "می‌آمد": { "fr": "venait", "note": "Imparfait de آمدن. À l'oral : می‌اومد." },
    "را": { "fr": "(marque du COD)", "note": "À l'oral : ـو. در را باز کرد → درو باز کرد." },
    "باز": { "fr": "ouvert" },
    "کرد": { "fr": "a fait", "note": "باز کرد = a ouvert." },
    "خوش": { "fr": "bien, agréable" },
    "آمدی": { "fr": "tu es venu(e)", "note": "خوش آمدی = bienvenue (à une personne). À l'oral : خوش اومدی." },
    "عزیزم": { "fr": "mon chéri, ma chérie", "note": "عزیز + ـم." },
    "بیا": { "fr": "viens" },
    "تو": { "fr": "(ici) à l'intérieur ; aussi : toi", "note": "بیا تو = entre." }
