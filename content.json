    "دایی": { "ref": "dayi" },
    "و": { "fr": "et" },
    "پسردایی‌ام": { "fr": "mon cousin (fils de l'oncle maternel)", "note": "پسردایی + ـام (« mon »)." },
    "منتظر": "منتظر",
    "من": { "fr": "moi, je" },
    "بودند": { "fr": "étaient", "note": "بود + ـند : 3e personne du pluriel, à l'écrit. À l'oral : بودن." },
    "هوا": { "fr": "l'air, le temps (météo)" },
    "گرم": { "fr": "chaud" },
    "بود": { "fr": "était" },
    "خیابان‌ها": { "fr": "les rues", "note": "خیابان + ـها (pluriel)." },
    "شلوغ": { "ref": "sholugh" },
    "راه": { "fr": "chemin, route" },
    "خانه": { "fr": "maison", "note": "À l'oral : خونه." },
    "پرسید": { "fr": "a demandé", "note": "پرسیدن = demander (une question)." },
    "گرسنه‌ای": { "fr": "tu as faim ?", "note": "گرسنه (affamé) + ـای (« tu es »). À l'oral : گشنه‌ای؟" },
    "گفتم": { "fr": "j'ai dit" },
    "خیلی": { "fr": "très, beaucoup" },
    "اما": { "ref": "amma" },
    "گیاه‌خوارم": "گیاهْ‌خوارَم",
      "گیاه‌خوار": "گیاهْ‌خوار",
    "خندید": { "fr": "a ri" },
    "گفت": { "fr": "a dit" },
    "نگران": { "fr": "inquiet, inquiète" },
    "نباش": { "fr": "ne sois pas", "note": "Impératif négatif de بودن." },
    "مادربزرگ": { "ref": "madarbozorg" },
    "عدس‌پلو": {"text": "عَدَس پُلو", "voice": "male"},
